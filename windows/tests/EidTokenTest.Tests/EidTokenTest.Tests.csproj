<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit tests of the verifier, the reader's policies and the command-line tool. Every certificate, CRL and OCSP
       response is generated inside the tests; nothing reaches a real OCSP responder or CRL server (fake transport,
       or a one-shot server on the loopback interface). -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EidTokenTest.Core\EidTokenTest.Core.csproj" />
    <ProjectReference Include="..\..\src\EidTokenTest.Cli\EidTokenTest.Cli.csproj" />
  </ItemGroup>

</Project>
