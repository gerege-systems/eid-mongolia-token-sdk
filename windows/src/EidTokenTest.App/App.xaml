<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="EidTokenTest.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- The window's theme: one accent (brand blue); success / warning / danger only for the check marks. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="EidAccentBrush" Color="#FF3A6DFF" />
                    <SolidColorBrush x:Key="EidSuccessBrush" Color="#FF107C10" />
                    <SolidColorBrush x:Key="EidWarningBrush" Color="#FF9D5D00" />
                    <SolidColorBrush x:Key="EidDangerBrush" Color="#FFBA1A1A" />
                    <SolidColorBrush x:Key="EidCardBackground" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="EidCardStroke" Color="#FFE5E7EB" />
                    <SolidColorBrush x:Key="EidSurfaceBrush" Color="#FFF9F9FC" />
                    <SolidColorBrush x:Key="EidMutedForeground" Color="#FF6B7280" />
                    <SolidColorBrush x:Key="EidTextForeground" Color="#FF0F172A" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="EidAccentBrush" Color="#FF84A8FF" />
                    <SolidColorBrush x:Key="EidSuccessBrush" Color="#FF6FCF6F" />
                    <SolidColorBrush x:Key="EidWarningBrush" Color="#FFE8B66A" />
                    <SolidColorBrush x:Key="EidDangerBrush" Color="#FFFFB4AB" />
                    <SolidColorBrush x:Key="EidCardBackground" Color="#FF1F1F23" />
                    <SolidColorBrush x:Key="EidCardStroke" Color="#FF34343A" />
                    <SolidColorBrush x:Key="EidSurfaceBrush" Color="#FF0B0E12" />
                    <SolidColorBrush x:Key="EidMutedForeground" Color="#FF9CA3AF" />
                    <SolidColorBrush x:Key="EidTextForeground" Color="#FFF8FAFC" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Thickness x:Key="PagePadding">32,24,32,32</Thickness>
            <Thickness x:Key="CardPadding">24</Thickness>
            <CornerRadius x:Key="RadiusMd">8</CornerRadius>

            <Style TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="PageTitleTextBlock" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{ThemeResource EidTextForeground}" />
            </Style>
            <Style x:Key="SectionTitleTextBlock" TargetType="TextBlock">
                <Setter Property="FontSize" Value="17" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{ThemeResource EidTextForeground}" />
            </Style>
            <Style x:Key="SubtleSubtitleTextBlock" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{ThemeResource EidMutedForeground}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="LineHeight" Value="20" />
            </Style>
            <Style x:Key="LabelTextBlock" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource EidMutedForeground}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="CardBorder" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource EidCardBackground}" />
                <Setter Property="BorderBrush" Value="{ThemeResource EidCardStroke}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
                <Setter Property="Padding" Value="{StaticResource CardPadding}" />
                <Setter Property="Margin" Value="0,0,0,16" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
